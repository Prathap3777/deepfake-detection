# SMTP Email Configuration for Gmail or any standard mail provider
# To use Gmail:
# 1. Enable 2-Step Verification in your Google Account: https://myaccount.google.com/security
# 2. Generate an App Password: https://myaccount.google.com/apppasswords
# 3. Enter your Gmail address and 16-character App Password below (no spaces).

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_16_character_app_password
MAIL_SENDER_NAME="Deepfake Face Authenticity AI"

# Flask Secret Key
FLASK_SECRET_KEY=deepfake-auth-secret-key-2026-production
