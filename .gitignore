# Virtual Environment
venv/
env/
.env

# Database
*.db
*.sqlite3

# Python Bytecode
__pycache__/
*.py[cod]
*$py.class

# Temporary Uploads & PDF Reports (keep directory, ignore contents)
static/uploads/*
!static/uploads/.gitkeep
static/reports/*
!static/reports/.gitkeep

# Pytest Cache & Local Artifacts
.pytest_cache/

# Large Dataset Images (keep directory structure)
dataset/real/*
!dataset/real/.gitkeep
dataset/fake/*
!dataset/fake/.gitkeep

# OS generated files
.DS_Store
Thumbs.db
